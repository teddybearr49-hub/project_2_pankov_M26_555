[6.50014328956604,"o","\u001b[?25l"]
[6.5113725662231445,"o","\u001b[93mu\u001b[?25h"]
[6.526607513427734,"o","\u001b[m\u001b[93m\buv \u001b[37mrun"]
[6.543793439865112,"o","\u001b[?25l\u001b[m\u001b[93m\u001b[4;56Huv \u001b[37mrun database\u001b[?25h"]
[7.210170269012451,"o","\u001b[m"]
[7.219996213912964,"o","\r\n"]
[7.46857213973999,"o","\r\n***База данных***"]
[7.469085216522217,"o","\u001b[?25l\u001b[8;1H***Операции с данными***\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\u001b[?25h"]
[7.4691948890686035,"o","\n<command> select from <имя_таблицы> - прочитать все записи.\r"]
[7.469271421432495,"o","\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r"]
[7.469359397888184,"o","\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r"]
[7.469469308853149,"o","\n<command> info <имя_таблицы> - вывести информацию о таблице.\r"]
[7.469551086425781,"o","\n<command> exit - выход из программы\r"]
[7.469647645950317,"o","\n<command> help - справочная информация\r"]
[7.469710111618042,"o","\n"]
[7.48860239982605,"o","\n>>>Введите команду:\u001b[1C"]
[14.543151378631592,"o","create_tab"]
[14.554109573364258,"o","le users name:str age:int"]
[14.971561908721924,"o","\r"]
[14.971975088119507,"o","\n"]
[14.973210096359253,"o","Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int\r"]
[15.001306772232056,"o","\n"]
[15.020154476165771,"o",">>>Введите команду: "]
[22.025407075881958,"o","insert int"]
[22.03949475288391,"o","o users values (\"Sergei\", 28)"]
[22.37231683731079,"o","\r"]
[22.372793436050415,"o","\n"]
[22.376721620559692,"o","Запись с ID=1 успешно добавлена в таблицу \"users\".\r"]
[22.376869201660156,"o","\nФункция insert выполнилась за 0.000 секунд.\r"]
[22.391441822052002,"o","\n>>>Введите команду:\u001b[1C"]
[28.32960343360901,"o","select fro"]
[28.34989881515503,"o","m users"]
[28.64030408859253,"o","\r"]
[28.641003131866455,"o","\n"]
[28.64475154876709,"o","Функция select выполнилась за 0.000 секунд.\r"]
[28.656200647354126,"o","\n"]
[28.764276266098022,"o","+----+--------+-----+\r\n| ID |  name  | age |\r\n+----+--------+-----+\r\n| 1  | Sergei |  28 |\r"]
[28.76445174217224,"o","\n+----+--------+-----+"]
[28.764528512954712,"o","\r"]
[28.77910351753235,"o","\n>>>Введите команду:\u001b[1C"]
[34.67274594306946,"o","delete fro"]
[34.681650161743164,"o","m users where ID = 1"]
[35.347076416015625,"o","\r"]
[35.34722018241882,"o","\n"]
[35.35789752006531,"o","Вы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[36.51033282279968,"o","n"]
[36.97926640510559,"o","\r"]
[36.979904651641846,"o","\n"]
[36.98013401031494,"o","Операция отменена.\r"]
[36.99439191818237,"o","\n>>>Введите команду:\u001b[1C"]
[42.25376558303833,"o","delete fro"]
[42.2725625038147,"o","m users where ID = 1"]
[42.95636200904846,"o","\r"]
[42.95649242401123,"o","\n"]
[42.9718554019928,"o","Вы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[44.475717544555664,"o","y"]
[44.8986234664917,"o","\r"]
[44.89883041381836,"o","\n"]
[44.9003381729126,"o","Запись с ID=1 успешно удалена из таблицы \"users\".\r"]
[44.92175006866455,"o","\n>>>Введите команду:\u001b[1C"]
[47.217772006988525,"o","e"]
[47.55601215362549,"o","x"]
[47.75570750236511,"o","i"]
[47.93493938446045,"o","t"]
[48.31675148010254,"o","\r"]
